---
import type { HTMLAttributes } from "astro/types"
import { Code } from "astro:components"

import { cn } from "../utils/cn"
import ResizableWindow from "./ResizableWindow.astro"

export interface Props extends HTMLAttributes<"section"> {
  code: string
}

const { class: className, code, ...attrs } = Astro.props
---

<section
  class={cn("bg-base-700/40 my-8 rounded-xl p-4 sm:my-12 sm:p-6", className)}
  {...attrs}
>
  <h2><slot name="heading" /></h2>

  <div class="relative mb-12">
    <ResizableWindow>
      <slot />
    </ResizableWindow>
  </div>

  <div class="overflow-hidden rounded-xl">
    <div class="border-base-400 bg-base-600 flex gap-2 border-b px-3 py-2">
      <div class="bg-base-400 h-3 w-3 rounded-full"></div>
      <div class="bg-base-400 h-3 w-3 rounded-full"></div>
      <div class="bg-base-400 h-3 w-3 rounded-full"></div>
    </div>
    <Code code={code} theme={"one-dark-pro"} lang={"css"} />
  </div>
</section>
